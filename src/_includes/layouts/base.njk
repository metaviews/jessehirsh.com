<!doctype html>
<html lang="{{ lang or 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or site.siteName }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  <meta name="robots" content="{% if noindex %}noindex,follow{% else %}index,follow{% endif %}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  {% set _ogImage = site.url + (heroImage or site.defaultOgImage) %}
  {% set _ogImageAlt = heroAlt or site.defaultOgImageAlt %}
  {% if lang == 'zh-CN' %}{% set _ogLocale = 'zh_CN' %}
  {% elif lang == 'fr' %}{% set _ogLocale = 'fr_FR' %}
  {% elif lang == 'es' %}{% set _ogLocale = 'es_ES' %}
  {% elif lang == 'de' %}{% set _ogLocale = 'de_DE' %}
  {% else %}{% set _ogLocale = 'en_CA' %}{% endif %}

  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ site.siteName }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ title or site.siteName }}">
  <meta property="og:description" content="{{ description or site.tagline }}">
  <meta property="og:image" content="{{ _ogImage }}">
  <meta property="og:image:alt" content="{{ _ogImageAlt }}">
  {% if not heroImage %}
  <meta property="og:image:width" content="{{ site.defaultOgImageWidth }}">
  <meta property="og:image:height" content="{{ site.defaultOgImageHeight }}">
  {% endif %}
  <meta property="og:locale" content="{{ _ogLocale }}">
  {% if _ogLocale != 'en_CA' %}<meta property="og:locale:alternate" content="en_CA">{% endif %}
  {% if _ogLocale != 'zh_CN' %}<meta property="og:locale:alternate" content="zh_CN">{% endif %}
  {% if _ogLocale != 'fr_FR' %}<meta property="og:locale:alternate" content="fr_FR">{% endif %}
  {% if _ogLocale != 'es_ES' %}<meta property="og:locale:alternate" content="es_ES">{% endif %}
  {% if _ogLocale != 'de_DE' %}<meta property="og:locale:alternate" content="de_DE">{% endif %}

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.siteName }}">
  <meta name="twitter:description" content="{{ description or site.tagline }}">
  <meta name="twitter:image" content="{{ _ogImage }}">
  <meta name="twitter:image:alt" content="{{ _ogImageAlt }}">

  <!-- Hreflang -->
  {% if not noindex and not noHreflang %}
  {% set _base = page.url | replace('/zh/', '/') | replace('/fr/', '/') | replace('/es/', '/') | replace('/de/', '/') %}
  <link rel="alternate" hreflang="en"    href="{{ site.url }}{{ _base }}">
  <link rel="alternate" hreflang="zh-CN" href="{{ site.url }}/zh{{ _base }}">
  <link rel="alternate" hreflang="fr"    href="{{ site.url }}/fr{{ _base }}">
  <link rel="alternate" hreflang="es"    href="{{ site.url }}/es{{ _base }}">
  <link rel="alternate" hreflang="de"    href="{{ site.url }}/de{{ _base }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ _base }}">
  {% endif %}

  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/css/site.css">

  {% set _schemaType = schemaType or 'WebPage' %}
  {% if '/topics/' in page.url and page.url != '/topics/' and page.url != '/zh/topics/' and page.url != '/fr/topics/' and page.url != '/es/topics/' and page.url != '/de/topics/' %}
    {% set _schemaType = schemaType or 'Article' %}
  {% elif page.url == '/brief/' or page.url == '/zh/brief/' or page.url == '/fr/brief/' or page.url == '/es/brief/' or page.url == '/de/brief/' %}
    {% set _schemaType = schemaType or 'WebApplication' %}
  {% elif page.url == '/hire/' or page.url == '/zh/hire/' or page.url == '/fr/hire/' or page.url == '/es/hire/' or page.url == '/de/hire/' or page.url == '/speaking/' or page.url == '/zh/speaking/' or page.url == '/fr/speaking/' or page.url == '/es/speaking/' or page.url == '/de/speaking/' %}
    {% set _schemaType = schemaType or 'Service' %}
  {% endif %}
  {% if not noindex %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "name": {{ site.siteName | json | safe }},
        "url": {{ site.url | json | safe }},
        "description": {{ site.tagline | json | safe }},
        "inLanguage": {{ (lang or 'en') | json | safe }},
        "publisher": { "@id": "{{ site.url }}/#person" }
      },
      {
        "@type": "Person",
        "@id": "{{ site.url }}/#person",
        "name": "Jesse Hirsh",
        "url": {{ site.url | json | safe }},
        "jobTitle": "Researcher, speaker, and strategist",
        "description": {{ site.tagline | json | safe }},
        "email": {{ site.bookingEmail | json | safe }},
        "sameAs": {{ site.sameAs | json | safe }}
      },
      {
        "@type": {{ _schemaType | json | safe }},
        "@id": "{{ site.url }}{{ page.url }}#webpage",
        "url": "{{ site.url }}{{ page.url }}",
        "name": {{ (title or site.siteName) | json | safe }},
        "description": {{ (description or site.tagline) | json | safe }},
        "inLanguage": {{ (lang or 'en') | json | safe }},
        "isPartOf": { "@id": "{{ site.url }}/#website" },
        "author": { "@id": "{{ site.url }}/#person" },
        "image": {{ _ogImage | json | safe }}
        {% if _schemaType == 'Service' %},
        "provider": { "@id": "{{ site.url }}/#person" },
        "areaServed": "Worldwide",
        "serviceType": {{ (title or 'Speaking and strategic advisory') | json | safe }}
        {% elif _schemaType == 'WebApplication' %},
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "CAD" }
        {% endif %}
      }
    ]
  }
  </script>
  {% endif %}

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-4VNVBBE8VK"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-4VNVBBE8VK');
  </script>
</head>
<body>
  <a class="skip-link" href="#main">{{ strings.skip }}</a>
  {% include "partials/nav.njk" %}
  <main id="main" class="container">
    {% block content %}{% endblock %}
  </main>
  {% include "partials/footer.njk" %}
</body>
</html>
